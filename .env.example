# Скопируй в .env и подставь свой ключ: cp .env.example .env
# Файл .env в git не попадает (см. .gitignore)
DEEPSEEK_API_KEY=sk-your-key-here

# Второй провайдер, нужен для задания 05 (console.groq.com/keys)
GROQ_API_KEY=gsk_your-key-here

# Доставка сводки в задании 18 (необязательно).
# Токен берётся у @BotFather, chat_id — у @userinfobot.
# Без них сводка пишется в 18-scheduled-mcp/data/outbox.log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
